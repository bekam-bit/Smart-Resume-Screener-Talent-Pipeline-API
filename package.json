{
  "name": "smart-resume-screener-talent-pipeline-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for an explainable, recruiter-controlled talent pipeline.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:validate": "node node_modules/prisma/build/index.js validate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "worker:email": "node node_modules/tsx/dist/cli.mjs src/workers/email.worker.ts",
    "worker:screening": "node node_modules/tsx/dist/cli.mjs src/workers/screening.worker.ts"
  },
  "prisma": {
    "seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@prisma/client": "^6.17.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mammoth": "^0.3.29",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "openai": "^7.33.0",
    "pg": "^8.23.1",
    "resend": "^6.4.2",
    "unpdf": "^1.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.12.0",
    "supertest": "^7.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
