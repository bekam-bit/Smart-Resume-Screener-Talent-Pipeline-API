{
  "info": {
    "name": "Smart Resume Screener & Talent Pipeline API",
    "description": "Production-ready Postman collection covering Authentication, Organizations, Jobs, Resumes, Applications, Screening Runs, and Audit Logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "organizationId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "resumeId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/live"
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/ready"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@talentstream.test\",\n  \"password\": \"Password123!\",\n  \"name\": \"Sarah Admin\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.tokens && res.tokens.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.tokens.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@talentstream.test\",\n  \"password\": \"Password123!\"\n}"
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "List Organizations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/organizations",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Technologies\",\n  \"slug\": \"acme-tech\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Search Public Jobs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs?q=TypeScript",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [{ "key": "q", "value": "TypeScript" }]
            }
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/organizations/{{organizationId}}/jobs",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Full Stack Engineer\",\n  \"description\": \"Build resilient recruitment pipelines with TypeScript and PostgreSQL.\"\n}"
            }
          }
        },
        {
          "name": "Publish Job",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/organizations/{{organizationId}}/jobs/{{jobId}}/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Applications & Screening",
      "item": [
        {
          "name": "Apply to Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs/{{jobId}}/applications",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resumeId\": \"{{resumeId}}\",\n  \"coverLetter\": \"Excited to apply for this role!\"\n}"
            }
          }
        },
        {
          "name": "Trigger Screening Run",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/organizations/{{organizationId}}/applications/{{applicationId}}/screen",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "List Screening Runs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/{{organizationId}}/applications/{{applicationId}}/screening-runs",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "List Organization Audit Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/{{organizationId}}/audit-logs",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    }
  ]
}
